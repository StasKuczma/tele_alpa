<?xml version="1.0"?>
<package format="3">
  <name>tele_alpa</name>
  <version>0.1.0</version>
  <description>
    ROS 2 nodes for Alpamayo 1.5: end-to-end trajectory planning and
    visual question answering (VQA) against live camera topics.
  </description>
  <maintainer email="staskuczma@gmail.com">Stanislaw Kuczma</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>autoware_internal_debug_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
